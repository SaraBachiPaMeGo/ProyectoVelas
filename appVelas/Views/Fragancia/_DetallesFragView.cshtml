@model IEnumerable<appVelas.Models.Fragancia>
@{
    Layout = null;
}
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompradoEn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Firma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.FragNombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CompradoEn)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Firma)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cantidad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Coste)
                </td>
                <td>

                    @*<p>

        </p>*@
                    @Html.ActionLink("Actualizar", "ActualizarView", new { IDFrag = item.IDFrag, vista = "Frag" }) |
                    @Html.ActionLink("Detalles", "DetallesView1", new { IDFrag = item.IDFrag, vista = "Frag" })
                    |  @Html.ActionLink("Eliminar", "Delete", new { id = item.IDFrag })
                </td>
            </tr>
        }
    </tbody>
</table>
