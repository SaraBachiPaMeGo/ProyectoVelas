@model IEnumerable<appVelas.Models.Pedido>
@{
    Layout = null;
}
<p>

</p>
<input type="text" id="buscadorTabla" class="form-control mb-3" placeholder="Buscar..." autocomplete="off" style="width: 29%;" />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaPedi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaEntrega)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IDVelaFin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IDCliente)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tablaDatos">
        @foreach (var item in Model)
        {
            <tr id="eliminar-row-@item.IDPedido">
                <td class="col-buscar">
                    @Html.DisplayFor(modelItem => item.FechaPedi)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaEntrega)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IDVelaFin)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IDCliente)
                </td>
                <td>
                    @Html.ActionLink("Actualizar", "ActualizarView", new { IDPedido = item.IDPedido, vista = "Pedido" }) |
                    @Html.ActionLink("Detalles", "DetallesView1", new { IDPedido = item.IDPedido, vista = "Pedido" })| 
                    <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Pedido" data-id="@item.IDPedido">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
