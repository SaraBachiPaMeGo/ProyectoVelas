@model IEnumerable<appVelas.Models.Cera>
@{
    Layout = null;
}

<p>

</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Firma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompradoEn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            @*<th>
                    @Html.DisplayNameFor(model => model.IDVela)
                </th>*@
            <th></th>
        </tr>
    </thead>
    <tbody id="tablaDatos">
        @foreach (var item in Model)
        {
            <tr data-coste="@item.Coste" id="eliminar-row-@item.IDCera" >
                <td class="col-buscar">
                    @Html.DisplayFor(modelItem => item.Firma)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CompradoEn)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cantidad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Coste)
                </td>
                @*<td>
                        @Html.DisplayFor(modelItem => item.IDVela)
                    </td>*@
                <td>
                    @Html.ActionLink("Actualizar", "ActualizarView", new { IDCera = item.IDCera, vista = "Cera" }, new { @class = "btn btn-outline-warning" }) |
                    @Html.ActionLink("Detalles", "DetallesView1", new { IDCera = item.IDCera, vista = "Cera" }, new { @class = "btn btn-outline-success" })|
                    <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Cera" data-id="@item.IDCera">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="alert alert-info" >
    Total Coste: <span id="totalCoste">
    @ViewBag.TotalCoste
</span>
</div>

