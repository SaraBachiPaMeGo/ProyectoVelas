@model appVelas.Models.Cera

<div>
    <h4>Cera</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IDCera)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IDCera)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Firma)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Firma)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tipo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tipo)
        </dd>
        <dt class="col-sm-2">
            Comprado en:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CompradoEn)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IDVela)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IDVela)
        </dd>
    </dl>
</div>
<div>
    @Html.ActionLink("Actualizar", "ActualizarView", new { id = Model.IDCera }, new { @class = "btn btn-outline-warning" }) |
    <a href="#" onclick="cargarVistaParcial('cera','miContenedor','Detalles')" class="btn btn-outline-success" > Back to List</a>
    |
    <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="cera" data-id="@Model.IDCera">
        Eliminar
    </button>

</div>
