@model IEnumerable<appVelas.Models.DTO.VelaDTO>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IDVela)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VelaNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaReal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NombreCera)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CantidadCera)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CantidadMecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CantidadEnd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagenContentType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IDVela)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VelaNombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaReal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Coste)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NombreCera)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadCera)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadMecha)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadEnd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Image)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImagenContentType)
            </td>
            <td>
                <span>@Html.ActionLink("Actualizar", "ActualizarView", new { IDVela = item.IDVela, vista = "Vela" })</span>  |
                @Html.ActionLink("Detalles", "DetallesView1", new { IDVela = item.IDVela, vista = "Vela" })
                |  <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Vela" data-id="@item.IDVela">
                    Eliminar
                </button>
            </td>
        </tr>
}
    </tbody>
</table>
