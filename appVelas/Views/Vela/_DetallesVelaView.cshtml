@model IEnumerable<appVelas.Models.DTO.VelaDTO>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaReal)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.NombreCera)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CantidadCera)
            </th>
            <th>
                Pigmentos
            </th>
            <th>
                Fragancias
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
        <tr data-coste="@item.Coste" id="eliminar-row-@item.IDVela">

            <td>
                @Html.DisplayFor(modelItem => item.FechaReal)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.NombreCera)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadCera)
            </td>
            <td>
                @if (item.VelaPigmentos != null)
                {
                    foreach (var it in item.VelaPigmentos)
                    {
                        <span>@it.NombrePigmento - @it.Cantidad</span>
                    }
                }
            </td>
            <td>
                @if (item.VelaFragancias != null)
                {
                    foreach (var it in item.VelaFragancias)
                    {
                        <span>@it.NombreFragancia - @it.Cantidad</span>
                    }
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Coste)
            </td>
            <td>
                @if (item.Image != null && item.Image.Length > 0)
                {
                    var base64 = Convert.ToBase64String(item.Image);
                    var imgSrc = $"data:{item.ImagenContentType};base64,{base64}";

                    <img src="@imgSrc" width="150" />
                }
            </td>
            <td>
                <span>@Html.ActionLink("Actualizar", "ActualizarView", new { IDVela = item.IDVela, vista = "Vela" }, new { @class = "btn btn-outline-warning" })</span>  |
                @Html.ActionLink("Detalles", "DetallesView1", new { IDVela = item.IDVela, vista = "Vela" }, new { @class = "btn btn-outline-success" })
                |  <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Vela" data-id="@item.IDVela">
                    Eliminar
                </button>
            </td>
        </tr>
            }
        }
        else
        {
            <p>El modelo es null</p>
        }

    </tbody>
</table>
<div class="alert alert-info">
    Total Coste: <span id="totalCoste">
        @ViewBag.TotalCoste
    </span>
</div>
