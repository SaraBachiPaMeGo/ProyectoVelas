@model IEnumerable<appVelas.Models.Vela>
@{
    List<Mecha> mechas = ViewData["Mecha"] as List<Mecha>;
    List<Molde> moldes = ViewData["Moldes"] as List<Molde>;
    List<Endurecedor> end = ViewData["end"] as List<Endurecedor>;
    List<Fragancia> frag = ViewData["Frag"] as List<Fragancia>;
    List<Pigmento> pig = ViewData["Pig"] as List<Pigmento>;
    List<Cera> cera = ViewData["Cera"] as List<Cera>;
}

    <div id="conDet">


    </div>

<p>
     
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.VelaNombre)
            </th>
            <th>
                Fragancia
            </th>
            <th>
                Pigmento
            </th>
            <th>
                Molde
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            @*<th>
            Es un pedido
        </th>*@
            <th>
                Mecha
            </th>
            <th>
                Cera
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaReal)
            </th>
            <th>
                Fecha venta
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.VelaNombre)
            </td>

            <td>
                @frag.FirstOrDefault(f => f.IDFrag == item.IDFrag)?.FragNombre

            </td>
            <td>
                @pig.FirstOrDefault(f => f.IDPig == item.IDPig)?.ColorNombre
            </td>
            <td>
                @moldes.FirstOrDefault(f => f.IDMolde == item.IDMolde)?.MoldeNombre

            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Coste)
            </td>
            @*<td>
            @pedis.FirstOrDefault(f => f.IDPedido == item.IDPedido).FragNombre

        </td>*@
        <td>
            @mechas.FirstOrDefault(f => f.IDMecha == item.IDMecha)?.Tipo

        </td>
        <td>
            @cera.FirstOrDefault(f => f.IDCera == item.IDCera)?.Tipo

        </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaReal)
            </td>
            <td>
                @*@Html.DisplayFor(modelItem => item.FechaVenta)*@
            </td>
            <td>
                <span>@Html.ActionLink("Actualizar", "ActualizarView", new { IDVela = item.IDVela, vista = "Vela" })</span>  |
                @Html.ActionLink("Detalles", "DetallesView1", new { IDVela = item.IDVela, vista = "Vela" })
                |  @Html.ActionLink("Eliminar", "Delete", new { id = item.IDVela })
            </td>
        </tr>
}
    </tbody>
</table>
