@model appVelas.Models.Vela

@{

    List<Mecha> mechas = ViewData["Mecha"] as List<Mecha> ?? new List<Mecha>();
    List<Molde> moldes = ViewData["Moldes"] as List<Molde> ?? new List<Molde>();
    List<Fragancia> frag = ViewData["Frag"] as List<Fragancia> ?? new List<Fragancia>();
    List<Pigmento> pig = ViewData["Pig"] as List<Pigmento> ?? new List<Pigmento>();
    List<Cera> cera = ViewData["Cera"] as List<Cera> ?? new List<Cera>();

}

    <script>
    const dropzone = document.getElementById("dropzone");
    const status = document.getElementById("status");

    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("dragover");
    });

    dropzone.addEventListener("dragleave", () => {
      dropzone.classList.remove("dragover");
    });

    dropzone.addEventListener("drop", async (e) => {
      e.preventDefault();
      dropzone.classList.remove("dragover");

      const file = e.dataTransfer.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append("file", file);
      formData.append("nombre", document.getElementById("nombre").value);
      formData.append("descripcion", document.getElementById("descripcion").value);

      try {
        const response = await fetch("https://localhost:5001/api/vela/upload", {
          method: "POST",
          body: formData
        });

        const data = await response.json();
        if (response.ok) {
          status.textContent = `✅ Imagen subida: ${data.path}`;
        } else {
          status.textContent = `❌ Error: ${data}`;
        }
      } catch (error) {
        status.textContent = `❌ Error al conectar con la API`;
      }
    });
    </script>

<h4>Vela</h4>
<hr />
<div class="row" style="display: block;margin-left: 3%;">
    <div >
        <form asp-action="_ActVelaView">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" style="display:none">
                <label asp-for="IDVela" class="control-label"></label>
                <input asp-for="IDVela" class="form-control" />
                <span asp-validation-for="IDVela" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VelaNombre" class="control-label"></label>
                <input asp-for="VelaNombre" class="form-control" />
                <span asp-validation-for="VelaNombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Observ" class="control-label"></label>
                <input asp-for="Observ" class="form-control" />
                <span asp-validation-for="Observ" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Endurecedor" /> @Html.DisplayNameFor(model => model.Endurecedor)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="FechaReal" class="control-label"></label>
                <input asp-for="FechaReal" class="form-control" />
                <span asp-validation-for="FechaReal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaVenta" class="control-label"></label>
                <input asp-for="FechaVenta" class="form-control" />
                <span asp-validation-for="FechaVenta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GradFrag" class="control-label"></label>
                <input asp-for="GradFrag" class="form-control" />
                <span asp-validation-for="GradFrag" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GradPig" class="control-label"></label>
                <input asp-for="GradPig" class="form-control" />
                <span asp-validation-for="GradPig" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Image" class="control-label">Image</label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            @*Por defecto la de siempre*@
            <div class="form-group">
                <label asp-for="IDMecha" class="control-label">Mecha:</label>
                <select name="IDMecha" id="IDMecha" class="form-control">

                    @foreach (var item in mechas)
                    {
                        if (@item.IDMecha == Model.IDMecha)
                        {
                            <option value="@item.IDMecha" selected>@item.Firma</option>

                        }
                        else
                        {
                            <option value="@item.IDMecha">@item.Firma</option>
                        }
                    }
                </select>
            </div>

            @*Por defecto la de siempre*@
            <div class="form-group">
                <label asp-for="IDCera" class="control-label">Cera:</label>
                <select name="IDCera" id="IDCera" class="form-control">

                    @foreach (var item in cera)
                    {
                        <option value="@item.IDCera">@item.Tipo</option>
                    }
                </select>
                @*<span asp-validation-for="IDCera" class="text-danger"></span>*@
            </div>

            @*lista de nombres de los moldes, puedes buscarlos escribiendo*@
            <div class="form-group">
                <label asp-for="IDMolde" class="control-label">Molde:</label>
                <select name="IDMolde" id="IDMolde" class="form-control">

                    @foreach (var item in moldes)
                    {
                        if (@item.IDMolde == Model.IDMecha)
                        {
                            <option value="@item.IDMolde" selected>@item.Firma</option>

                        }
                        else
                        {
                            <option value="@item.IDMolde">@item.MoldeNombre</option>
                        }
                    }
                </select>
            </div>

            @*lista de nombres de las fragancias, puedes buscarlas escribiendo*@
            <div class="form-group">
                <label asp-for="IDFrag" class="control-label">Fragrancia/s</label>
                <select id="fragancias" name="IDFragancias" multiple="multiple" class="form-control select2">
                    @foreach (var fragan in ViewBag.Fragancias as SelectList)
                    {
                        var selected = ((List<Guid>)ViewBag.FraganciasSeleccionadas).Contains(Guid.Parse(fragan.Value)) ? "selected" : "";
                        <option value="@fragan.Value">@fragan.Text</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="IDPig" class="control-label">Color/es</label>
                <select id="pigmentos" name="IDPigmentos" multiple="multiple" class="form-control select2">
                    @foreach (var pigt in ViewBag.Pigmentos as SelectList)
                    {
                        var selected = ((List<Guid>)ViewBag.PigmentosSeleccionados).Contains(Guid.Parse(pigt.Value)) ? "selected" : "";
                        <option value="@pigt.Value">@pigt.Text</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Coste" class="control-label"></label>
                <input asp-for="Coste" class="form-control" />
                <span asp-validation-for="Coste" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IDPedido" class="control-label"></label>
                <input asp-for="IDPedido" class="form-control" />
                <span asp-validation-for="IDPedido" class="text-danger"></span>
            </div>

            <div id="dropzone">Arrastra tu imagen aquí</div>
            <p id="status"></p>

            @*enctype="multipart/form-data*@

            <div class="form-group">
                <label for="Imagen">Seleccionar imagen</label>
                <input type="file" name="imagen" accept="image/*" class="form-control" />
            </div>

            <div class="form-group">
                <input type="submit" value="Actualizar" class="btn btn-outline-warning" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
