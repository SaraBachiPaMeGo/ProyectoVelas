@model appVelas.Models.Vela

@{

    List<Mecha> mechas = ViewData["Mecha"] as List<Mecha> ?? new List<Mecha>();
    List<Molde> moldes = ViewData["Moldes"] as List<Molde> ?? new List<Molde> ();
    List<Endurecedor> end = ViewData["end"] as List<Endurecedor> ?? new List<Endurecedor> ();
    List<Pack> pack = ViewData["Pack"] as List<Pack> ?? new List<Pack> ();
    //List<Fragancia> frag = ViewData["Frag"] as List<Fragancia> ?? new List<Fragancia> ();
    //List<Pigmento> pig = ViewData["Pig"] as List<Pigmento> ?? new List<Pigmento> ();
    List<Cera> cera = ViewData["Cera"] as List<Cera> ?? new List<Cera> ();
    var fragancias = ViewData["Frag"] as List<Fragancia> ?? new List<Fragancia>();
    var pigmentos = ViewData["Pig"] as List<Pigmento> ?? new List<Pigmento>(); 

}

<style>
    .col {
        -ms-flex-preferred-size: 0;
        flex-basis: 0;
        -ms-flex-positive: 1;
        flex-grow: 1;
        max-width: 48%;
    }

</style>
<div style="margin-left: 3%;">
    <h4>Vela</h4>
    <hr />
    <div>
        <p>
            Para velas con mucho detalle
        </p>
        <p>
            <ul style="background:inherit">
                <li>CERA + END = 75 - 80 ºC</li>
                <li>CERA + PIG = 65 - 70 ºC</li>
                <li>CERA + FRAG = 60 - 65 ºC</li>
                <li>VERTER EN MOLDE 68 - 72 ºC</li>
            </ul>
        </p>
    </div>
    <div class="row">
        <div>
            <form asp-action="_CrearVelaView" enctype="multipart/form-data" style="padding: 0rem;margin: 0rem;
                -webkit-JsonProperty-count: 4;display: inline;margin-left: 3%; " id="formMolde">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Cantidad" class="control-label">¿Cuántas velas vas a crear?:</label>
                    <input asp-for="Cantidad" type="number" step="any" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>

                @*<div >*@
                <div class="form-group">
                    <label asp-for="VelaNombre" class="control-label">Nombre:</label>
                    <input asp-for="VelaNombre" class="form-control" />
                    <span asp-validation-for="VelaNombre" class="text-danger"></span>
                </div>

                @*Por defecto la de siempre*@
                <div class="form-group">
                    <label asp-for="IDMecha" class="control-label">Mecha:</label>
                    <select name="IDMecha" id="IDMecha" class="form-control">

                        @foreach (var item in mechas)
                        {
                            <option value="@item.IDMecha">@item.Firma</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="CantidadMecha" class="control-label">cm:</label>
                    <input asp-for="CantidadMecha" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="CantidadMecha" class="text-danger"></span>
                </div>


                @*Por defecto la de siempre*@
                <div class="form-group">
                    <label asp-for="IDCera" class="control-label">Cera:</label>
                    <select name="IDCera" id="IDCera" class="form-control">

                        @foreach (var item in cera)
                        {
                            <option value="@item.IDCera">@item.Tipo</option>
                        }
                    </select>
                    @*<span asp-validation-for="IDCera" class="text-danger"></span>*@
                </div>

                <div class="form-group">
                    <label asp-for="CantidadCera" class="control-label">g:</label>
                    <input asp-for="CantidadCera" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="CantidadCera" class="text-danger"></span>
                </div>


                @*lista de nombres de los moldes, puedes buscarlos escribiendo*@
                <div class="form-group">
                    <label asp-for="IDMolde" class="control-label">Molde:</label>
                    <select name="IDMolde" id="IDMolde" class="form-control">

                        @foreach (var item in moldes)
                        {
                            <option value="@item.IDMolde">@item.MoldeNombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="control-label">Endurecedor:</label>
                    <select name="IDEnd" class="form-control">
                        @foreach (var e in end)
                        {
                            <option value="@e.IDEndurecedor">@e.Firma</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="GradEnd" class="control-label">ºC:</label>
                    <input asp-for="GradEnd" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="GradEnd" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CantidadEnd" class="control-label">g:</label>
                    <input asp-for="CantidadEnd" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="CantidadEnd" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="control-label">Colores</label>
                    <select asp-for="Pigmentos" name="IDPigmentos" class="form-control select2" multiple="multiple">
                        @foreach (var pigt in pigmentos)
                        {
                            <option value="@pigt.IDPig">@pigt.ColorNombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="GradPig" class="control-label">ºC:</label>
                    <input asp-for="GradPig" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="GradPig" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CantidadPig" class="control-label">ml:</label>
                    <input asp-for="CantidadPig" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="CantidadPig" class="text-danger"></span>
                </div>

                @*lista de nombres de las fragancias, puedes buscarlas escribiendo*@
                <div class="form-group">
                    <label class="control-label">Fragancias</label>
                    <select asp-for="Fragancias" name="IDFragancias" class="form-control select2" multiple="multiple">
                        @foreach (var fraga in fragancias)
                        {
                            <option value="@fraga.IDFrag">@fraga.FragNombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="CantidadFrag" class="control-label">ml :</label>
                    <input asp-for="CantidadFrag" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="CantidadFrag" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="GradFrag" class="control-label">ºC :</label>
                    <input asp-for="GradFrag" class="form-control" style="width: 60%;" />
                    <span asp-validation-for="GradFrag" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Observ" class="control-label"></label>
                    <textarea style="width: 230%;" asp-for="Observ" class="form-control"> </textarea>
                    <span asp-validation-for="Observ" class="text-danger"></span>
                </div>
                @*</div>*@

                <div style="display:flex">
                    <div id="dropzone">Arrastra tu imagen aquí</div>

                    <input type="file" id="fileInput" accept="image/*" hidden name="file" />
                    <img id="preview" style=" display:none; width: 300px; margin-left: 52px; height: 200px;" />
                    <p id="status"></p>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-outline-success" style="margin-top: 43%; margin-left: 31%;">Crear</button>
                </div>
            </form>
            <div class="form-group">
                @*PASAR A LA VISTA PARCIAL EL IDVELA@*@
                <div class="form-group checkbox-container">
                    <label for="miCheckbox" class="checkbox-label">¿Es un pedido?</label>
                    <input type="checkbox" id="idCheckPedi" onclick="manejarCheckbox('contPedi','idCheckPedi','pedido','Crear')" class="checkbox-input">
                    <span class="checkbox-text">Sí</span>
                </div>
            </div>
        </div>
    </div>

    @*<div>
            
        </div>*@

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</div>

