@model appVelas.Models.Pigmento

<h4>Pigmento</h4>
<hr />
<div class="row" style="display: block;margin-left: 3%;">
    <div >
        <form asp-action="ActualizarView" asp-controller="Pigmento" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" style="display: none">
                <label asp-for="IDPig" class="control-label" style="display: none"></label>
                <input asp-for="IDPig" class="form-control" />
                <span asp-validation-for="IDPig" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Firma" class="control-label"></label>
                <input asp-for="Firma" class="form-control" />
                <span asp-validation-for="Firma" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tipo" class="control-label"></label>
                <input asp-for="Tipo" class="form-control" />
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ColorNombre" class="control-label">Nombre</label>
                <input asp-for="ColorNombre" class="form-control" />
                <span asp-validation-for="ColorNombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CompradoEn" class="control-label">Comprado en:</label>
                <input asp-for="CompradoEn" class="form-control" />
                <span asp-validation-for="CompradoEn" class="text-danger"></span>
            </div>
            <div class="form-group" style="display: none">
                <label asp-for="IDVela" class="control-label"></label>
                <input asp-for="IDVela" class="form-control" />
                <span asp-validation-for="IDVela" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Coste" class="control-label"></label>
                <input asp-for="Coste" class="form-control" />
                <span asp-validation-for="Coste" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Actualizar" class="btn btn-outline-warning" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="#" onclick="cargarVistaParcial('pig','miContenedor','Detalles')"> Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
