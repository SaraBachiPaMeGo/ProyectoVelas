@model IEnumerable<appVelas.Models.Pigmento>

@{
    Layout = null;
}

<p>

</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Firma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ColorNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompradoEn)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Firma)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ColorNombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CompradoEn)
                </td>
               
                <td>
                    @Html.DisplayFor(modelItem => item.Cantidad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Coste)
                </td>
                <td>
                    @Html.ActionLink("Actualizar", "ActualizarView", new { IDPig = item.IDPig, vista = "Pig" }) |
                    @Html.ActionLink("Detalles", "DetallesView1", new { IDPig = item.IDPig, vista = "Pig" })
                </td>
            </tr>
        }
    </tbody>
</table>
