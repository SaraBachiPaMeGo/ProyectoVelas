@model IEnumerable<appVelas.Models.Pigmento>

@{
    Layout = null;
}

<p>

</p>

<input type="text" id="buscadorTabla" class="form-control mb-3" placeholder="Buscar..." autocomplete="off" style="width: 29%;" />
<table class="table">
    <thead>
        <tr>
          
            <th>
                @Html.DisplayNameFor(model => model.ColorNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tablaDatos">
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <tr data-coste="@item.Coste" id="eliminar-row-@item.IDPig">
                    <td class="col-buscar">
                        @Html.DisplayFor(modelItem => item.ColorNombre)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Cantidad)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Coste)
                    </td>
                    <td>
                        @Html.ActionLink("Actualizar", "ActualizarView", new { IDPig = item.IDPig, vista = "Pig" }, new { @class = "btn btn-outline-warning" }) |
                        @Html.ActionLink("Detalles", "DetallesView1", new { IDPig = item.IDPig, vista = "Pig" }, new { @class = "btn btn-outline-success" })
                        | <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Pigmento" data-id="@item.IDPig">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <p>El modelo fue null</p>
        }

    </tbody>
</table>
