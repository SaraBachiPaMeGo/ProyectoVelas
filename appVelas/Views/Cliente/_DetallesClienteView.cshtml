@model IEnumerable<appVelas.Models.Cliente>
@{
    Layout = null;
}
<p>
    <a asp-action="_CrearClienteView">Añadir nuevo cliente</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telf)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IDPedido)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Direccion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Telf)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IDPedido)
                </td>
                <td>
                    @Html.ActionLink("Actualizar", "ActualizarView", new { IDCliente = item.IDCliente, vista = "Cliente" }) |
                    @Html.ActionLink("Detalles", "DetallesView1", new { IDCliente = item.IDCliente, vista = "Cliente" })  |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.IDCliente })
                </td>
            </tr>
        }
    </tbody>
</table>
