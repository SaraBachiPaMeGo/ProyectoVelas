@model appVelas.Models.Molde

@{
    string IDMolde = ViewData["IDMolde"] as string;
}


<h4>Molde</h4>
<hr />
<div class="row" style="display: block;margin-left: 3%;">
    <div >
        <form enctype="multipart/form-data" asp-action="ActualizarView" style="display:inline-block" id="formMolde">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" style="display: none">
                <label asp-for="IDMolde" class="control-label"></label>
                <input asp-for="IDMolde" class="form-control" />
                <span asp-validation-for="IDMolde" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MoldeNombre" class="control-label"></label>
                <input asp-for="MoldeNombre" class="form-control" />
                <span asp-validation-for="MoldeNombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Firma" class="control-label"></label>
                <input asp-for="Firma" class="form-control" />
                <span asp-validation-for="Firma" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tipo" class="control-label"></label>
                <input asp-for="Tipo" class="form-control" />
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CompradoEn" class="control-label"></label>
                <input asp-for="CompradoEn" class="form-control" />
                <span asp-validation-for="CompradoEn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GramCera" class="control-label">g Cera</label>
                <input asp-for="GramCera" class="form-control" />
                <span asp-validation-for="GramCera" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Medidas" class="control-label"></label>
                <input asp-for="Medidas" class="form-control" />
                <span asp-validation-for="Medidas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Duracion" class="control-label"></label>
                <input asp-for="Duracion" class="form-control" />
                <span asp-validation-for="Duracion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CMMecha" class="control-label">cm Mecha</label>
                <input asp-for="CMMecha" class="form-control" />
                <span asp-validation-for="CMMecha" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MilAgua" class="control-label">ml Agua</label>
                <input asp-for="MilAgua" class="form-control" />
                <span asp-validation-for="MilAgua" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Coste" class="control-label"></label>
                <input asp-for="Coste" class="form-control" />
                <span asp-validation-for="Coste" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Observ" class="control-label"></label>
                <textarea style="width: 230%;" asp-for="Observ" class="form-control"> </textarea>
                <span asp-validation-for="Observ" class="text-danger"></span>
            </div>

            <div style="display:flex">
                <div id="dropzone">Actualiza tu imagen aquí</div>

                <input type="file" id="fileInput" accept="image/*" hidden name="file" />
                <img id="preview" style=" display:none; width: 300px; margin-left: 52px; height: 200px;" />
                <p id="status"></p>
            </div>

            <div class="form-group">
                <input type="submit" value="Actualizar" class="btn btn-outline-warning" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="#" onclick="cargarVistaParcial('molde','miContenedor','Detalles')"> Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
