@model IEnumerable<appVelas.Models.Molde>

@{
    Layout = null;
}

<p>

</p>
<input type="text" id="buscadorTabla" class="form-control mb-3" placeholder="Buscar..." autocomplete="off" style="width: 29%;" />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MoldeNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Firma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompradoEn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GramCera)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Medidas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Duracion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CMMecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Observ)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MilAgua)
            </th>
          
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tablaDatos">
        @foreach (var item in Model)
        {
            <tr id="eliminar-row-@item.IDMolde">
                <td class="col-buscar">
                    @Html.DisplayFor(modelItem => item.MoldeNombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Firma)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CompradoEn)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GramCera)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Medidas)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Duracion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CMMecha)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Observ)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MilAgua)
                </td>
                
                <td>
                    @Html.DisplayFor(modelItem => item.Coste)
                </td>
                <td>
                    @Html.ActionLink("Actualizar", "ActualizarView", new { IDMolde = item.IDMolde, vista = "Molde" }) |
                    @Html.ActionLink("Detalles", "DetallesView1", new { IDMolde = item.IDMolde, vista = "Molde" }) |
                    <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Molde" data-id="@item.IDMolde">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
