@model IEnumerable<appVelas.Models.Molde>

@{
    Layout = null;
}

<p>

</p>
<input type="text" id="buscadorTabla" class="form-control mb-3" placeholder="Buscar..." autocomplete="off" style="width: 29%;" />
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Firma)
            </th>
            
          
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tablaDatos">
        @foreach (var item in Model)
        {
            <tr id="eliminar-row-@item.IDMolde">
                <td class="col-buscar">
                    @Html.DisplayFor(modelItem => item.MoldeNombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Firma)
                </td>
               
                <td>
                    @Html.DisplayFor(modelItem => item.Coste)
                </td>
                <td>
                    <div >
                        @if (item.Image != null && item.Image.Length > 0)
                        {
                            var base64 = Convert.ToBase64String(item.Image);
                            var imgSrc = $"data:{item.ImagenContentType};base64,{base64}";

                            <img src="@imgSrc" width="150" />
                        }
                        @Html.ActionLink("Actualizar", "ActualizarView", new { IDMolde = item.IDMolde, vista = "Molde" }, new { @class = "btn btn-outline-warning" }) |
                        @Html.ActionLink("Detalles", "DetallesView1", new { IDMolde = item.IDMolde, vista = "Molde" }, new { @class = "btn btn-outline-success" }) |
                        <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Molde" data-id="@item.IDMolde">
                            Eliminar
                        </button>
                    </div>
                   
                </td>
            </tr>
        }
    </tbody>
</table>
