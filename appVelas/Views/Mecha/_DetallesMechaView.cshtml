
    @model IEnumerable<appVelas.Models.Mecha>

    @{
        Layout = null;
    }

    <div>
        <p>

        </p>
        <input type="text" id="buscadorTabla" class="form-control mb-3" placeholder="Buscar..." autocomplete="off" style="width: 29%;" />

        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Firma)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Tipo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CompradoEn)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.Cantidad)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Coste)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tablaDatos">
                @foreach (var item in Model)
                {
                    <tr id="eliminar-row-@item.IDMecha">
                        <td class="col-buscar">
                            @Html.DisplayFor(modelItem => item.Firma)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Tipo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CompradoEn)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Cantidad)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Coste)
                        </td>
                        <td>
                            @Html.ActionLink("Actualizar", "ActualizarView", new { IDMecha = item.IDMecha, vista = "Mecha" }) |
                            @Html.ActionLink("Detalles", "DetallesView1", new { IDMecha = item.IDMecha, vista = "Mecha" })
                            @*|@Html.ActionLink("Eliminar", "Delete", new { id = item.IDMecha })*@
                            <button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Mecha" data-id="@item.IDMecha">
                                Eliminar
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>