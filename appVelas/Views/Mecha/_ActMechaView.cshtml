@model appVelas.Models.Mecha

@{
    string IDMecha = ViewData["IDMecha"] as string;
}


<h4>Mecha</h4>
<hr />
<div class="row" style="display: block;margin-left: 3%;">
    <div >
        <form asp-action="ActualizarView" asp-controller="Mecha" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" style="display: none">
                <label asp-for="IDMecha" class="control-label"></label>
                <input asp-for="IDMecha" class="form-control" />
                <span asp-validation-for="IDMecha" class="text-danger"></span>
            </div>
            <div class="form-group" style="display: none">
                <label asp-for="IDVela" class="control-label"></label>
                <input asp-for="IDVela" class="form-control" />
                <span asp-validation-for="IDVela" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Firma" class="control-label"></label>
                <input asp-for="Firma" class="form-control" />
                <span asp-validation-for="Firma" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tipo" class="control-label"></label>
                <input asp-for="Tipo" class="form-control" />
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CompradoEn" class="control-label">Comprado en:</label>
                <input asp-for="CompradoEn" class="form-control" />
                <span asp-validation-for="CompradoEn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Coste" class="control-label"></label>
                @*<input type="text" id="prueba" />*@
                <input asp-for="Coste" type="text" class="form-control" />
                <span asp-validation-for="Coste" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-outline-warning" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<script>
document.getElementById("prueba").addEventListener("input", e => {
    console.log(e.target.value);
});
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
