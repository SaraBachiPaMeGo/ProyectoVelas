@model appVelas.Models.Documento

<h4>Documento</h4>
<hr />
<div class="row" style=" display: block; margin-left: 3%;">
    <div>
        <form asp-action="_CrearDocView">
            <div></div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Pack:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="form-group">
                <label asp-for="IDDoc" class="control-label"></label>
                <input asp-for="IDDoc" class="form-control" />
                <span asp-validation-for="IDDoc" class="text-danger"></span>
            </div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Vela:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Endurecedor:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Mecha:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Cera:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Fragancia:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Pigmento:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="checkbox-container form-group">
                <label for="miCheckbox" class="checkbox-label">Molde:</label>
                <input type="checkbox" id="idCheckCli" onclick="manejarCheckbox('contCli', 'idCheckCli','cliente','Crear')" class="checkbox-input">
                <span class="checkbox-text" @*onclick="cargarVistaParcial('pedido')"*@>Sí</span>
            </div>
            <div class="form-group">
                <label asp-for="NombreDoc" class="control-label"></label>
                <input asp-for="NombreDoc" class="form-control" />
                <span asp-validation-for="NombreDoc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TipoDoc" class="control-label">Tipo:</label>
                <input asp-for="TipoDoc" class="form-control" />
                <span asp-validation-for="TipoDoc" class="text-danger"></span>
            </div>


            @*//------------------------*@
            <div class="form-group">
                <label asp-for="Datos" class="control-label"></label>
                <input asp-for="Datos" class="form-control" />
                <span asp-validation-for="Datos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Documento">Seleccionar documento PDF</label>
                <input type="file" name="archivo" accept="application/pdf" class="form-control" />
            </div>


            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

