@model IEnumerable<appVelas.Models.Endurecedor>
@{
    Layout = null;
}
<p>

</p>
<input type="text" id="buscadorTabla" class="form-control mb-3" placeholder="Buscar..." autocomplete="off" style="width: 29%;" />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Firma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coste)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tablaDatos">
        @foreach (var item in Model)
        {
            <tr data-coste="@item.Coste" id="eliminar-row-@item.IDEndurecedor">
                <td class="col-buscar">
                    @Html.DisplayFor(modelItem => item.Firma)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cantidad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Coste)
                </td>
                <td>
                    @Html.ActionLink("Actualizar", "ActualizarView", new { IDEndurecedor = item.IDEndurecedor, vista = "Endurecedor" }, new { @class = "btn btn-outline-warning" }) |
                    @Html.ActionLink("Detalles", "DetallesView1", new { IDEndurecedor = item.IDEndurecedor, vista = "Endurecedor" }, new { @class = "btn btn-outline-success" })
                    |<button class="btn btn-danger btn-eliminar btn-eliminar" data-tipo="Endurecedor" data-id="@item.IDEndurecedor">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="alert alert-info">
    Total Coste: <span id="totalCoste">
        @ViewBag.TotalCoste
    </span>
</div>

